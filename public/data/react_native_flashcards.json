    {
        "id": 2,
        "topic": "React Native",
        "question": "How does React Native handle navigation between screens?",
        "answer": "React Native does not have built-in navigation like a browser. Instead, it uses libraries such as 'React Navigation' to enable navigation between screens in a mobile app.",
        "keyPoints": [
            "React Navigation is the most commonly used library.",
            "Supports stack, tab, and drawer-based navigation.",
            "Uses navigators like StackNavigator and BottomTabNavigator.",
            "Navigation state is managed internally by React Navigation."
        ],
        "codeExample": "import { createStackNavigator } from '@react-navigation/stack';\nconst Stack = createStackNavigator();\nfunction App() {\n  return (\n    <NavigationContainer>\n      <Stack.Navigator>\n        <Stack.Screen name='Home' component={HomeScreen} />\n      </Stack.Navigator>\n    </NavigationContainer>\n  );\n}",
        "resources": [
            {
                "name": "React Navigation Documentation",
                "url": "https://reactnavigation.org/docs/getting-started/"
            }
        ],
